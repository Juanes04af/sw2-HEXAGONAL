<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="720.0"
        prefWidth="1100.0"
        stylesheets="@styles.css"
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="co.edu.poli.sw2.ProyectoHexa.infraestructura.ui.ControlDrone">

    <!-- ============================= -->
    <!-- CABECERA                      -->
    <!-- ============================= -->

    <top>

        <VBox
                spacing="3"
                styleClass="barra-titulo">

            <Label
                    styleClass="titulo-app"
                    text="Gestion de Drones" />

            <Label
                    styleClass="subtitulo-app"
                    text="Arquitectura Hexagonal | Drone de Vigilancia | PostgreSQL | Clima Open-Meteo" />

        </VBox>

    </top>


    <!-- ============================= -->
    <!-- PESTANAS                      -->
    <!-- ============================= -->

    <center>

        <TabPane tabClosingPolicy="UNAVAILABLE">

            <tabs>

                <!-- Pestana 1: CRUD de drones -->
                <Tab text="Drones">

                    <content>

                        <BorderPane>

                <!-- ============================= -->
                <!-- FORMULARIO                    -->
                <!-- ============================= -->

                <left>
                        <ScrollPane
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                prefWidth="345.0"
                minWidth="300.0"
                maxWidth="345.0"
                styleClass="scroll-formulario">


                    <VBox
                            prefWidth="330"
                            spacing="15">

                        <padding>

                            <Insets
                                    top="16"
                                    right="16"
                                    bottom="16"
                                    left="16" />

                        </padding>


                        <VBox
                                spacing="9"
                                styleClass="tarjeta">

                            <Label
                                    styleClass="titulo-seccion"
                                    text="DRONE DE VIGILANCIA" />

                            <Label
                                    styleClass="etiqueta-campo"
                                    text="Serial" />

                            <TextField
                                    fx:id="txtSerial"
                                    promptText="Ej: VIG-001" />


                            <Label
                                    styleClass="etiqueta-campo"
                                    text="Fabricante" />

                            <TextField
                                    fx:id="txtFabricante"
                                    promptText="Ej: DJI" />


                            <Label
                                    styleClass="etiqueta-campo"
                                    text="Modelo" />

                            <TextField
                                    fx:id="txtModelo"
                                    promptText="Ej: Mavic 3" />


                            <Label
                                    styleClass="etiqueta-campo"
                                    text="Peso (kg)" />

                            <TextField
                                    fx:id="txtPeso"
                                    promptText="Ej: 0.9" />


                            <CheckBox
                                    fx:id="chkDeteccionTermica"
                                    text="Deteccion termica" />

                        </VBox>


                        <!-- ===================== -->
                        <!-- CRUD                  -->
                        <!-- ===================== -->

                        <VBox
                                spacing="10"
                                styleClass="tarjeta">

                            <Label
                                    styleClass="titulo-seccion"
                                    text="OPERACIONES" />

                            <GridPane
                                    hgap="8"
                                    vgap="8">

                                <columnConstraints>

                                    <ColumnConstraints
                                            percentWidth="50" />

                                    <ColumnConstraints
                                            percentWidth="50" />

                                </columnConstraints>


                                <Button
                                        maxWidth="Infinity"
                                        onAction="#crearDrone"
                                        styleClass="boton,boton-primario"
                                        text="Crear"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="0" />

                                <Button
                                        maxWidth="Infinity"
                                        onAction="#modificarDrone"
                                        styleClass="boton,boton-secundario"
                                        text="Modificar"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0" />

                                <Button
                                        maxWidth="Infinity"
                                        onAction="#eliminarDrone"
                                        styleClass="boton,boton-peligro"
                                        text="Eliminar"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="1" />

                                <Button
                                        maxWidth="Infinity"
                                        onAction="#limpiarFormulario"
                                        styleClass="boton,boton-neutro"
                                        text="Limpiar"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1" />

                            </GridPane>

                        </VBox>


                        <!-- ===================== -->
                        <!-- BUSQUEDA              -->
                        <!-- ===================== -->

                        <VBox
                                spacing="8"
                                styleClass="tarjeta">

                            <Label
                                    styleClass="titulo-seccion"
                                    text="BUSCAR POR ID" />

                            <TextField
                                    fx:id="txtBuscarId"
                                    promptText="ID del drone" />

                            <Button
                                    maxWidth="Infinity"
                                    onAction="#buscarDrone"
                                    styleClass="boton,boton-secundario"
                                    text="Buscar" />

                            <Button
                                    maxWidth="Infinity"
                                    onAction="#listarDrones"
                                    styleClass="boton,boton-neutro"
                                    text="Listar todos" />

                        </VBox>


                        <Label
                                fx:id="lblMensaje"
                                wrapText="true" />

                    </VBox>
                    </ScrollPane>

                </left>


                <!-- ============================= -->
                <!-- TABLA                         -->
                <!-- ============================= -->

                <center>

                    <VBox
                            spacing="10"
                            styleClass="tarjeta">

                        <BorderPane.margin>

                            <Insets
                                    top="16"
                                    right="16"
                                    bottom="16"
                                    left="0" />

                        </BorderPane.margin>


                        <Label
                                styleClass="titulo-seccion"
                                text="DRONES REGISTRADOS" />


                        <TableView
                                fx:id="tablaDrones"
                                VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn
                                        fx:id="colId"
                                        prefWidth="55"
                                        text="ID" />

                                <TableColumn
                                        fx:id="colTipo"
                                        prefWidth="105"
                                        text="Tipo" />

                                <TableColumn
                                        fx:id="colSerial"
                                        prefWidth="115"
                                        text="Serial" />

                                <TableColumn
                                        fx:id="colFabricante"
                                        prefWidth="115"
                                        text="Fabricante" />

                                <TableColumn
                                        fx:id="colModelo"
                                        prefWidth="115"
                                        text="Modelo" />

                                <TableColumn
                                        fx:id="colPeso"
                                        prefWidth="90"
                                        text="Peso" />

                                <TableColumn
                                        fx:id="colDeteccionTermica"
                                        prefWidth="135"
                                        text="Deteccion termica" />

                            </columns>


                            <placeholder>

                                <Label
                                        text="No hay drones registrados." />

                            </placeholder>

                        </TableView>

                    </VBox>

                </center>

                        </BorderPane>

                    </content>

                </Tab>

                <!-- Pestana 2: suscripciones y notificaciones del clima -->
                <Tab text="Clima">

                    <content>

                        <fx:include source="clima.fxml" />

                    </content>

                </Tab>

                <!-- Pestana 3: consumo de bateria por estrategia (Strategy) -->
                <Tab text="Consumo">

                    <content>

                        <fx:include source="consumo.fxml" />

                    </content>

                </Tab>

            </tabs>

        </TabPane>

    </center>

</BorderPane>