<?xml version="1.0" encoding="UTF-8"?>

<!--
  Pestana de estado: ciclo operativo del dron como automata (patron State).
  Autores: Alejandra Cano y Juan Rosero
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="co.edu.poli.sw2.ProyectoHexa.infraestructura.ui.ControlEstado">

    <!-- OPERACIONES -->
    <left>
        <VBox prefWidth="330" spacing="15">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16" />
            </padding>

            <VBox spacing="9" styleClass="tarjeta">
                <Label styleClass="titulo-seccion" text="DRONE" />
                <ComboBox fx:id="cmbDrone" maxWidth="Infinity" promptText="Seleccione un drone" />
                <Button maxWidth="Infinity" onAction="#actualizarLista"
                        styleClass="boton,boton-neutro" text="Actualizar lista" />
            </VBox>

            <VBox spacing="9" styleClass="tarjeta">
                <Label styleClass="titulo-seccion" text="OPERACIONES" />
                <Button maxWidth="Infinity" onAction="#encender"
                        styleClass="boton,boton-primario" text="Encender" />
                <Button maxWidth="Infinity" onAction="#despegar"
                        styleClass="boton,boton-secundario" text="Despegar" />
                <Button maxWidth="Infinity" onAction="#iniciarAterrizaje"
                        styleClass="boton,boton-secundario" text="Iniciar aterrizaje" />
                <Button maxWidth="Infinity" onAction="#finalizarAterrizaje"
                        styleClass="boton,boton-secundario" text="Finalizar aterrizaje" />
                <Button maxWidth="Infinity" onAction="#apagar"
                        styleClass="boton,boton-peligro" text="Apagar" />
            </VBox>

            <Label fx:id="lblMensaje" wrapText="true" />
        </VBox>
    </left>

    <!-- AUTOMATA, DRONES E HISTORIAL -->
    <center>
        <VBox spacing="15">
            <BorderPane.margin>
                <Insets top="16" right="16" bottom="16" left="0" />
            </BorderPane.margin>

            <VBox spacing="10" styleClass="tarjeta">
                <Label styleClass="titulo-seccion" text="AUTOMATA DEL ESTADO OPERATIVO" />

                <HBox alignment="CENTER" spacing="8">
                    <Label fx:id="lblNodoApagado" styleClass="nodo-estado" text="APAGADO" />
                    <Label styleClass="flecha-estado" text="↔" />
                    <Label fx:id="lblNodoEspera" styleClass="nodo-estado" text="EN ESPERA" />
                    <Label styleClass="flecha-estado" text="→" />
                    <Label fx:id="lblNodoVolando" styleClass="nodo-estado" text="VOLANDO" />
                    <Label styleClass="flecha-estado" text="→" />
                    <Label fx:id="lblNodoAterrizando" styleClass="nodo-estado" text="ATERRIZANDO" />
                    <Label styleClass="flecha-estado" text="→ EN ESPERA" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="etiqueta-campo" text="Estado actual:" />
                    <Label fx:id="lblEstadoActual" styleClass="valor-destacado" text="-" />
                </HBox>
            </VBox>

            <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                <Label styleClass="titulo-seccion" text="DRONES Y ESTADO OPERATIVO" />

                <TableView fx:id="tablaDrones" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                        <TableColumn fx:id="colSerial" prefWidth="160" text="Serial" />
                        <TableColumn fx:id="colEstado" prefWidth="160" text="Estado" />
                    </columns>
                    <placeholder>
                        <Label text="No hay drones registrados." />
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
